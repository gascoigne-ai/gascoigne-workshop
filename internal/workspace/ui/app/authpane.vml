<scroll state="scroll" pad="{{gutter}}" gap="8">
  <row h="{{rowH}}" gap="6">
    <slot for="chip in types" name="chip"/>
  </row>
  <!-- view.Lines written out (markup has no lines) -->
  <col if="none">
    <text color="muted" h="{{labelH}}">No authentication</text>
  </col>
  <!-- widget.FormRow written out (markup has no form-row): 12 is its label
       gap; settingspane.vml has the other copy -->
  <row for="row in fields" h="{{rowH}}" gap="12">
    <text w="120">{{row.Label}}</text>
    <row if="row.Chips" gap="6">
      <slot for="chip in row.Chips" name="chip"/>
    </row>
    <field if="row.Input" state="row.Input" grow="1" bg="sunken" on-change="row.Sync" text-menu="row.Input"/>
  </row>
  <!-- widget.CheckRow written out (markup has no check-row); settingspane.vml
       has the other copies -->
  <row if="hasSecret" h="{{rowH}}" gap="8" on-click="toggleSecrets">
    <checkbox on="{{showSecrets}}"/>
    <text>Show secrets</text>
  </row>
</scroll>
